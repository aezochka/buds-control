<!--
    Логотип EBuds в духе Material 3 Expressive.

    Два наушника как крупные скруглённые формы, между ними — «E» из трёх
    штрихов, читаемая и на маленькой иконке. Никаких тонких линий: в MD3E
    формы плотные и уверенные, чтобы силуэт узнавался в 48dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Левый наушник: капля с ножкой -->
    <path
        android:fillColor="#1B1B1F"
        android:pathData="M34,30
            m -13,0
            a 13,13 0 1,0 26,0
            a 13,13 0 1,0 -26,0 Z" />
    <path
        android:fillColor="#1B1B1F"
        android:pathData="M28,40
            L40,40
            Q44,40 44,46
            L44,66
            Q44,74 36,74
            Q28,74 28,66 Z" />

    <!-- Правый наушник -->
    <path
        android:fillColor="#1B1B1F"
        android:pathData="M74,30
            m -13,0
            a 13,13 0 1,0 26,0
            a 13,13 0 1,0 -26,0 Z" />
    <path
        android:fillColor="#1B1B1F"
        android:pathData="M64,40
            L76,40
            Q80,40 80,46
            L80,66
            Q80,74 72,74
            Q64,74 64,66 Z" />

    <!-- «E» между наушниками: три плотных штриха -->
    <path
        android:fillColor="#1B1B1F"
        android:pathData="M50,36 L58,36 Q60,36 60,39 Q60,42 58,42 L50,42 Q48,42 48,39 Q48,36 50,36 Z" />
    <path
        android:fillColor="#1B1B1F"
        android:pathData="M50,49 L57,49 Q59,49 59,52 Q59,55 57,55 L50,55 Q48,55 48,52 Q48,49 50,49 Z" />
    <path
        android:fillColor="#1B1B1F"
        android:pathData="M50,62 L58,62 Q60,62 60,65 Q60,68 58,68 L50,68 Q48,68 48,65 Q48,62 50,62 Z" />
