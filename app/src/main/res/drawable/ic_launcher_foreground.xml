<?xml version="1.0" encoding="utf-8"?>
<!--
    Лого EBuds: один крупный наушник-капля.

    Прошлый вариант был мелким и дробным — два наушника плюс буква не читались
    в 48dp. Здесь одна уверенная форма во весь холст, как требует MD3
    Expressive: силуэт узнаётся сразу, деталей минимум.

    Безопасная зона adaptive-icon — центральные 66 из 108, поэтому вся
    геометрия держится в пределах 26..82.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        Корпус наушника: круглая головка сверху и ножка вниз.
        Одна непрерывная фигура, без стыков и тонких линий.
    -->
    <path
        android:fillColor="#101014"
        android:pathData="M54,26
            C40,26 29,37 29,51
            C29,61 35,69 44,73
            L44,78
            C44,82 47,84 51,84
            L57,84
            C61,84 64,82 64,78
            L64,73
            C73,69 79,61 79,51
            C79,37 68,26 54,26 Z" />

    <!--
        Внутренний вырез — звуковой канал. Цвет фона иконки, поэтому
        читается как отверстие и добавляет объём силуэту.
    -->
    <path
        android:fillColor="#B8E86B"
        android:pathData="M54,38
            C46,38 40,44 40,51
            C40,58 46,63 54,63
            C62,63 68,58 68,51
            C68,44 62,38 54,38 Z" />

    <!--
        «E» внутри выреза: три коротких плотных штриха.
        На маленьком размере сливаются в аккуратный знак, не в шум.
    -->
    <path
        android:fillColor="#101014"
        android:pathData="M47,44 L61,44 A2.5,2.5 0 0,1 61,49 L47,49 A2.5,2.5 0 0,1 47,44 Z" />
    <path
        android:fillColor="#101014"
        android:pathData="M47,49 L56,49 A2.5,2.5 0 0,1 56,54 L47,54 A2.5,2.5 0 0,1 47,49 Z" />
    <path
        android:fillColor="#101014"
        android:pathData="M47,54 L61,54 A2.5,2.5 0 0,1 61,59 L47,59 A2.5,2.5 0 0,1 47,54 Z" />
</vector>
